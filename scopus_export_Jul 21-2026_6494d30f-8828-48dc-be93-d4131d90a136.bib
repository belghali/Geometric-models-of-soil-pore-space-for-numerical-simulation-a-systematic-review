@ARTICLE{San José Martínez201032,
	author = {San José Martínez, F. and Martín, M.A. and Caniego, F.J. and Tuller, M. and Guber, A. and Pachepsky, Y. and García-Gutiérrez, C.},
	title = {Multifractal analysis of discretized X-ray CT images for the characterization of soil macropore structures},
	year = {2010},
	journal = {Geoderma},

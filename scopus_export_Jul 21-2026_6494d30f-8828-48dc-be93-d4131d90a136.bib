@ARTICLE{Monga20071140,
	author = {Monga, Olivier and Ndeye Ngom, Fatou and François Delerue, Jean},
	title = {Representing geometric structures in 3D tomography soil images: Application to pore-space modeling},
	year = {2007},
	journal = {Computers and Geosciences},
	volume = {33},
	number = {9},

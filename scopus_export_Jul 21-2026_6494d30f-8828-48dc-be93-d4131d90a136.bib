	keywords = {Bentonite; Deterioration; Homogenization method; Hydraulic conductivity; Lamellar structures; Linear transformations; Mechanical permeability; Numerical methods; Particle size analysis; Pore size; Pore structure; Capillary model; Contaminated sand; Cutoff wall; Performance; Retardance; Retardance performance; Sand particles; Soil bentonite; Soil-bentonite backfills; Vertical cutoff wall; Heavy metals},
	type = {Article},

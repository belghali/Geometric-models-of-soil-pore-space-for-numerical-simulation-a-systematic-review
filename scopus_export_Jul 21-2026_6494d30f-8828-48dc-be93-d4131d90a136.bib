@ARTICLE{Mahabadi201927,
	author = {Mahabadi, Nariman and Zheng, Xianglei and Yun, Tae Sup and Jang, Jaewon},
	title = {Gas Bubble Nucleation and Migration in Soils—Pore-Network Model Simulation},
	year = {2019},
	journal = {Sustainable Civil Infrastructures},

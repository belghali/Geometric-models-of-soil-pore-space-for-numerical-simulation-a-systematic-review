	keywords = {Analytic equipment; Computation theory; Computerized tomography; Machine learning; Microplastic; Statistical mechanics; microplastic; Experimental approaches; Lattice Boltzmann method; Machine learning techniques; Machine-learning; Micro CT; Microplastics; Modeling approach; Non-fickian transports; Pore-network modeling; Reactive transport; colloid; machine learning; micro-computed tomography; microfluidics; nonhuman; pharmaceutics; plume; review; Microfluidics},
	type = {Review},

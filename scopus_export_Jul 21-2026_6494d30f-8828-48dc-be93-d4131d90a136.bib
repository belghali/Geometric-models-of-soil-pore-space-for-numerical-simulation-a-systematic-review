@CONFERENCE{Nikooee20141007,
	author = {Nikooee, E. and Habibagahi, G. and Khaksar, H. and Hassanizadeh, S.M. and Raoof, A.},
	title = {Pore network modeling of unsaturated soils: Fundamentals, recent advancements and future perspectives},
	year = {2014},
	journal = {Numerical Methods in Geotechnical Engineering - Proceedings of the 8th European Conference on Numerical Methods in Geotechnical Engineering, NUMGE 2014},
	volume = {2},
	pages = {1007 - 1012},
	url = {https://www.scopus.com/pages/publications/84902329539?origin=resultslist},
	abstract = {Being composed of three different phases, namely, soil, water and air, as well as three different interfaces, unsaturated soils are too complex to be dealt with conventional modeling techniques. In recent years, a great wealth of research has been devoted to introduce new modeling tools which can better portray pore and grain geometry and the two-fluid flow occurring in these media. Such conceptual models have improved our understanding of hydraulics and physics of unsaturated soils. Pore network models (PNMs), vastly used in other disciplines such as petroleum engineering, are one of these advances which have recently been introduced in unsaturated soil mechanics. PNMs are basically conceptual models consisting of pores and throats that idealize the porous space of unsaturated soils. When the geometry and topology of the pore network are specified, then physical laws can be implemented in the network to model various phenomena of interest. The use of PNMs in geotechnical engineering and soil mechanics has been limited. A critical review of basics of pore network modeling, the current state of the art and the potential capabilities of PNMs to answer the questions of unsaturated soil mechanics is greatly beneficial. This paper aims at introducing the capabilities of pore network models in modeling unsaturated soil behavior. It demonstrates how PNMs can be employed to address different problems in unsaturated soil mechanics. For this purpose, recent advancements are reviewed and future perspectives are introduced. Furthermore, a PNM is employed to demonstrate the capabilities of PNMs to model the temperature effects on SWRC. The results indicate that the PNM is capable of capturing the experimental features observed in laboratory. © 2014 Taylor & Francis Group, London.},
	keywords = {Complex networks; Geotechnical engineering; Numerical methods; Petroleum engineering; Phase interfaces; Soil mechanics; Topology; Conceptual model; Conventional modeling; Future perspectives; Pore-network modeling; Pore-network models; Potential capability; Unsaturated soil; Unsaturated soil mechanics; Soils},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

@ARTICLE{Dassanayake202025,
	author = {Dassanayake, Sandun M. and Mousa, Ahmad},
	title = {Hydraulic Response of an Internally Stable Gap-Graded Soil Under Variable Hydraulic Loading: A Coupled DEM-Monte Carlo Approach},
	year = {2020},
	journal = {Sustainable Civil Infrastructures},
	pages = {25 - 33},
	doi = {10.1007/978-3-030-34252-4_3},
	url = {https://www.scopus.com/pages/publications/85102178414?origin=resultslist},
	abstract = {Seepage-induced fines migration, referred to as suffusion, conceivably degrades the hydraulic performance of soil masses subjected to water flow. Suffusion susceptibility of the soil (i.e. internal instability) is empirically evaluated using the grain size distribution (GSD) with little emphasis on the permeation process of fines (i.e. mobile fines) in the matrix. Upon experiencing different hydraulic gradient histories, the mobile fines can detach (unclog) or filtrate (clog) in the pore space of the load bearing soil skeleton (i.e. primary fabric). Moreover, clogging and unclogging phenomena are instrumental to temporally altering the hydraulic responses, mainly the hydraulic conductivity (K) and critical hydraulic gradient required to initiate internal erosion of the soil. Therefore, real-time predictions of the hydraulic response of the soil can reveal the initiation and progression of suffusion. This study attempts to forecast the hydraulic response of the soil by quantifying the statistical distribution of K values under mobile fines contents (f<sub>c</sub>). To this end, the discrete element method (DEM) has been employed to estimate the void ratio distribution of the primary fabric. The statistical Monte Carlo simulations have been performed using the Kozeny-Carman equation and the void ratio distribution to estimate the statistical distribution of K values. A set of pilot-scale experiments were conducted on internally stable gap-graded soil subjected to stepwise hydraulic loading histories to allow validation for the numerical results. Based on the measured pore pressure distribution parallel to the seepage path, the possible clogging and filtration of fines were inferred, and the K variations were estimated. The change in GSD of the soil after testing was used as a measure for the mobile fines fraction. An average of 6–8% mass loss (from the fine fraction) was observed over a 45-min duration of the controlled-head flows. The experimentally observed K (1–3 × 10<sup>−4</sup> m/s) and f<sub>c</sub> ranges fall well within the non-parametric bounds of the predicted K and f<sub>c</sub> (&lt;10%) ranges. © 2020, Springer Nature Switzerland AG.},
	author_keywords = {DEM; Fines migration; Inverse modeling; Statistical techniques; Temporal suffusion},
	keywords = {Finite difference method; Flow of water; Grain size and shape; Monte Carlo methods; Seepage; Soil structure interactions; Soils; Critical hydraulic gradient; Grain size distribution; Hydraulic performance; Kozeny-Carman equation; Monte Carlo approach; Pilot-scale experiments; Statistical distribution; Void ratio distributions; Soil testing},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}


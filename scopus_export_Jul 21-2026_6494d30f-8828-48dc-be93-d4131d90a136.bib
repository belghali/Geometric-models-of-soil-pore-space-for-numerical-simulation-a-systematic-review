@ARTICLE{Que20241591,
	author = {Que, Yun and Chen, Xian and Jiang, Zhenliang and Cai, Peichen and Xue, Bin and Xie, Xiudong},
	title = {Pore-scale permeability estimation of undisturbed granite residual soil: A comparison study by different methods},
	year = {2024},
	journal = {Journal of Soils and Sediments},
	volume = {24},

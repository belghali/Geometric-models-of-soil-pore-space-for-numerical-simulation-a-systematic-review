@ARTICLE{Ding2026,
	author = {Ding, Tianyu and Guo, Zichun and Chen, Yueming and Wang, Yuekai and Tian, Shenzhong and Zhao, Yali and Liu, Jianli and Peng, Xinhua},
	title = {X-ray CT-derived pore structure determines soil gas transport under high soil water content in clayey but not sandy soils},
	year = {2026},
	journal = {Smart Agricultural Technology},
	volume = {13},
	pages = {},
	doi = {10.1016/j.atech.2026.101916},
	url = {https://www.scopus.com/pages/publications/105034771181?origin=resultslist},
	abstract = {AbstractSoil gas transport is fundamentally governed by pore structure characteristics and water content, yet the predictive value of X-ray computed tomography (CT)–derived pore metrics across soil textures under high water content remains unclear. We conducted two 8-year field experiments on contrasting soils: clay soil (Shajiang black soil) and sandy soil (Fluvo-aquic soil), each comprising tillage systems (no-tillage, NT; rotary tillage, RT) and straw management (straw return, S; straw removal, RS). We measured relative gas diffusivity (D<sub>s</sub>/D<sub>0</sub>), air permeability (K<sub>a</sub>) and computed effective oxygen diffusion coefficient (D) across different matric potentials (-1∼-330 hPa) for soil depths of 0-10 cm and 10-20 cm. CT was used to quantify pore structure characteristics, including image-based porosity, pore size distributions, and pore skeletonization parameters (branch, junction, tortuosity). In clay soil, RTS significantly enhanced D<sub>s</sub>/D<sub>0</sub> and K<sub>a</sub> by 32.3% and 34.3% (P<0.05), respectively, at -330 hPa in 10-20 cm depth versus NTS. No significant differences were found among D<sub>s</sub>/D<sub>0</sub> between two tillage practices or straw management in sandy soil (P>0.05). RTS also increased 100-300 μm porosity, total porosity, branch number, and junction number in 10-20 cm depth of both soil types (P<0.05). Strong positive correlations were observed in clay soil between D<sub>s</sub>/D<sub>0</sub>, K<sub>a</sub> and >100 μm porosity, branch number, junction density, branch length density, and total porosity across all tested matric potentials (P<0.05). However, such relationships were largely absent in sandy soil. The computed D tracked air-filled porosity but did not capture pathway connectivity. In conclusion, under high water content, gas transport is structure-limited in clay and water-limited in sand. Therefore, the optimal strategies derived from our study are the adoption of RT with straw incorporation to enhance aeration in clay soil, and the use of NT with straw mulching to conserve water while preserving soil aeration in sandy soils. © 2026 The Author(s). Published by Elsevier B.V. This is an open access article under the CC BY-NC license. http://creativecommons.org/licenses/by-nc/4.0/},
	author_keywords = {Air permeability; Conservation tillage; Gas diffusivity; Pore structure; Rotary tillage; Soil gas transport; X-ray computed tomography},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Schollenberger20242647,
	author = {Schollenberger, Theresa and von Wolff, Lars and Bringedal, Carina and Pop, Iuliu Sorin and Rohde, Christian and Helmig, Rainer},
	title = {Investigation of Different Throat Concepts for Precipitation Processes in Saturated Pore-Network Models},
	year = {2024},
	journal = {Transport in Porous Media},
	volume = {151},
	number = {14},
	pages = {2647 - 2692},
	doi = {10.1007/s11242-024-02125-5},
	url = {https://www.scopus.com/pages/publications/85205848773?origin=resultslist},
	abstract = {The development of reliable mathematical models and numerical discretization methods is important for the understanding of salt precipitation in porous media, which is relevant for environmental problems like soil salinization. Models on the pore scale are necessary to represent local heterogeneities in precipitation and to include the influence of solution-air-solid interfaces. A pore-network model for saturated flow, which includes the precipitation reaction of salt, is presented. It is implemented in the open-source simulator DuMuX. In this paper, we restrict ourselves to one-phase flow as a first step. Since the throat transmissibilities determine the flow behaviour in the pore network, different concepts for the decreasing throat transmissibility due to precipitation are investigated. We consider four concepts for the amount of precipitation in the throats. Three concepts use information from the adjacent pore bodies, and one employs a pore-throat model obtained by averaging the resolved pore-scale model in a thin-tube. They lead to different permeability developments, which are caused by the different distribution of the precipitate between the pore bodies and throats. We additionally apply two different concepts for the calculation of the transmissibility. One obtains the precipitate distribution from analytical assumptions, the other from a geometric minimization principle using a phase-field evolution equation. The two concepts do not show substantial differences for the permeability development as long as simple pore-throat geometries are used. Finally, advantages and disadvantages of the concepts are discussed in the context of the considered physical problem and a reasonable effort for the implementation and computational costs. © The Author(s) 2024.},
	author_keywords = {Numerical simulations; Pore-network model; Porous-media flow; Salt precipitation},
	keywords = {Digital elevation model; Discretization method; Environmental problems; Numerical discretization; Pore throat; Pore-network modeling; Porous medium; Porous medium flow; Precipitation process; Salt precipitation; Soil salinization; numerical method; permeability; porosity; precipitation (chemistry); salt; saturated medium; Single European Market; Porous materials},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Wang2022,
	author = {Wang, Feng and Zhang, Xiaoxian and Neal, Andrew L. and Crawford, John W. and Mooney, Sacha J. and Bacq-Labreuil, Aurélie},
	title = {Evolution of the transport properties of soil aggregates and their relationship with soil organic carbon following land use changes},
	year = {2022},
	journal = {Soil and Tillage Research},
	volume = {215},
	pages = {},
	doi = {10.1016/j.still.2021.105226},
	url = {https://www.scopus.com/pages/publications/85117155541?origin=resultslist},
	abstract = {Aggregates are functional units to describe the impact of soil structural changes on physical and biogeochemical processes in soil. Both incubation and field experiments have shown that changing agricultural practices could reshape the intra-aggregate structure in a matter of days, but most such data were obtained from a single time-point and it is hence impossible to interpret that such a change was just a temporal transition or the new equilibria towards which the aggregates had evolved following the management changes. Understanding this is indispensable as intra-aggregate structure and its ability to transport substrates modulate all biogeochemical processes involved in soil carbon and nutrient cycle. This paper investigates this using soil samples archived from a reversion experiment initiated in 2008 at Rothamsted Research (UK), where parts of a plot that had been fallow since the 1950 s were converted to wheat or grass in 2008. We used X-ray Computed Tomography images, acquired at voxel size 1.5 µm, of aggregates in the archived soils to investigate the evolution of transport property of the aggregates over time, as well as its relationship with soil organic carbon (SOC). We also evaluated the development of pore connectedness following the conversion. The results show that the transport ability of the aggregates explains the SOC change much better than the porosity, and that noticeable changes in porosity of the connected pores and their ability to transport substrates did not emerge until the sixth year after the conversion. Ten years after the conversion, there was still no sign of the porosity of the connected pores and the bulk diffusion coefficient to plateau. In addition, we found the conversion to grass changed the intra-aggregate pore geometry significantly in that the bulk diffusion coefficients of their aggregates trends with their porosities in a way differing significantly from those for the bare fallow and arable treatments. All these suggest that the intra-aggregate reconfiguration following the conversion is a slow process, and that the ability of pore space to transport substrates is more important than the habitat they provide in SOC stabilisation. © 2021 Elsevier B.V.},
	author_keywords = {Bulk diffusion coefficient; Intra-aggregate structure; Land use change; Long-term experiment; Soil organic carbon},
	keywords = {Agriculture; Biogeochemistry; Computerized tomography; Diffusion; Information management; Land use; Organic carbon; Porosity; Soils; Transport properties; Aggregate structures; Biogeochemical process; Bulk diffusion coefficients; Functional units; Intra-aggregate structure; Landuse change; Long-term experiments; Soil aggregate; Soil organic carbon; Transport substrates; land use change; organic carbon; pore space; soil aggregate; soil carbon; Aggregates},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 33; All Open Access; Green Open Access}
}

@ARTICLE{Zhang2024,
	author = {Zhang, Zhao and Zhu, Kao-fei and He, Yong and Ni, Xue-qian and Wang, Hao and Zhang, Ke-neng},
	title = {Investigation on structural evolution and permeability of Cr(VI) contaminated sand-bentonite upon loading},
	year = {2024},
	journal = {Construction and Building Materials},
	volume = {439},
	pages = {},
	doi = {10.1016/j.conbuildmat.2024.137318},
	url = {https://www.scopus.com/pages/publications/85197569881?origin=resultslist},
	abstract = {Soil-bentonite (SB) vertical cutoff walls are subjected to combined external stress and chemical invasion during construction and operation, leading to a deterioration in impermeability and retardance performance. To address this issue, a series of consolidation-permeability tests and microscopic analysis were conducted on Cr(VI) contaminated sand-bentonite backfill to study its performance and microstructural responses under coupled chemo-mechanical conditions. Experimental results demonstrated that the proposed sand-bentonite backfill with 5 % bentonite content showed a low hydraulic conductivity 3.0×10<sup>−8</sup> cm/s, sufficiently satisfying the anti-seepage requirement (k<1.0×10<sup>−7</sup> cm/s) of the cutoff wall. Microstructural analysis revealed that the sand-bentonite backfill presented an initially loose single-porosity structure with a peak pore size of 7.19 μm, regarding contacted sand particles as the soil skeleton and bentonite matrix as the pore filler. The infiltration of high-concentration Cr(VI) solution improved the backfill hydraulic conductivity by promoting the aggregation of bentonite layers. Upon loading, sand particles gradually approached and squeezed each other, which was accompanied by a transformation of bentonite matrix from a lamellar structure into a denser reticular one. Furthermore, the hydraulic conductivity of the SB backfills was well reproduced using a capillary model considering the pore structure evolution. Additionally, the long-term retardance performance of the SB vertical cutoff wall was analyzed and evaluated based on a two-dimension example by numerical simulation method. Simulation results demonstrated that the breakthrough time of a 1.0 m thick cutoff wall could reach approximately 9.6 years, indicating a good retardancy capacity of the proposed SB cutoff wall. © 2024 Elsevier Ltd},

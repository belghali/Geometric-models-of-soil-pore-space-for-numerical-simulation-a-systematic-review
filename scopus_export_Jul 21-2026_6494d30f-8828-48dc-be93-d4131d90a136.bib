@ARTICLE{Sattari2020,
	author = {Sattari, Amir Shoarian and Siebelist, Marlena and Toker, Nabi Kartal and Wuttke, Frank},
	title = {Simulation of hysteresis in soil–water retention with a correlation between the invading pressure to the governing effective flow area},
	year = {2020},
	journal = {Granular Matter},
	volume = {22},

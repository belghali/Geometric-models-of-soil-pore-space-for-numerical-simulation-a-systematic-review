	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Zhang2026189,
	author = {Zhang, Yan and Wang, Yongjun and Wang, Jin and He, Chengdan and Li, Wenfeng and Zhang, Huzhong and Li, Yasheng and Li, Detian},
	title = {Numerical simulation of water migration in lunar soil based on the Monte Carlo model},
	year = {2026},
	journal = {Acta Astronautica},
	volume = {243},
	pages = {189 - 201},
	doi = {10.1016/j.actaastro.2026.01.067},
	url = {https://www.scopus.com/pages/publications/105028774923?origin=resultslist},
	abstract = {This study proposes a geometric model based on the Monte Carlo method to enable precise characterization of porous media structures in lunar soil and validates its reliability by numerically reconstructing experimental investigations into the effects of adsorption behavior on water migration at −100 °C. Based on this model, the prolonging effect of the regolith on ice retention time was quantitatively analyzed, and the influence mechanisms of key parameters such as temperature, thickness, and specific surface area were systematically elucidated. The study indicates that the particle size distribution of lunar soil can be described by a unified cumulative probability distribution, and the reconstruction model based on the Monte Carlo method can effectively characterize pore structure features. The time required for the regolith to achieve saturated adsorption shows a linear dependence on its thickness. The additional retention time of water ice is most sensitive to temperature variations. At temperatures not exceeding 110 K, even a regolith layer thinner than 1 m can extend the preservation of water ice by several hundred million years. However, once the temperature exceeds 110 K, the protective capacity of the overlying layer declines exponentially within the narrow temperature range of 110 K–120 K. In warmer lunar regions, the regolith's capacity to retain water ice is limited. Even deeply buried water ice will gradually dissipate over extended geological timescales. Based on the mechanisms described above, this study suggests that in permanently shadowed regions with temperatures below 110 K, water ice may be detectable within the uppermost 1 m of the regolith. In contrast, in regions with temperatures ranging from 120 K to 140 K, the required detection depth may extend to tens of meters. This study provides a theoretical foundation for understanding the distribution and preservation mechanisms of water ice on the lunar surface. The methodologies developed and the conclusions drawn provide valuable scientific insights for future in-situ detection missions targeting lunar polar regions. © 2026 IAA},
	author_keywords = {Lunar soil; Model reconstruction; Monte Carlo; Retention time; Water migration},
	keywords = {Adsorption; Ice; Lunar missions; Lunar surface analysis; Particle size; Particle size analysis; Pore structure; Probability distributions; Soils; Geometric models; Lunar soil; Model-based OPC; Modeling reconstruction; Monte carlo; Monte Carlo model; MonteCarlo methods; Retention time; Water ice; Water migration; Monte Carlo methods},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{He2025,
	author = {He, Jie and Chen, Cong and Liu, Fangcheng and Sun, Bai and Liu, Qing and You, Long},
	title = {Dynamic characteristics of rubber-cement soil in seawater corrosive environments},
	year = {2025},
	journal = {Engineering Research Express},
	volume = {7},
	number = {4},
	pages = {},
	doi = {10.1088/2631-8695/ae29cb},
	url = {https://www.scopus.com/pages/publications/105025754572?origin=resultslist},
	abstract = {To enhance the dynamic performance and durability of cement-based soil in coastal environments, this paper studies the mechanical behavior of rubber-mixed cement soil under the coupled action of dynamic loads and seawater erosion. Through systematic resonance column tests, the influence laws of seawater concentration, rubber content, and confining pressure on the dynamic shear modulus and damping ratio of rubber-cement soil were mainly discussed. The results show that during the process of seawater erosion, the coupling effect of ion diffusion, expansive force, and osmotic pressure leads to the damage of the soil skeleton and the roughening of the pore structure, causing edge cracking. However, the incorporation of rubber significantly alleviates this deterioration trend. After 28 days of seawater erosion, with the increase of rubber content, the dynamic shear modulus showed a nonlinear change of first decreasing and then increasing, while the damping ratio first increased and then decreased and tended to stabilize. Specifically, when the rubber content is 15% and 20%, the maximum dynamic shear modulus increases by 12.9% and 30.7% respectively, compared with that before erosion, demonstrating a significant performance recovery effect. In addition, the high-concentration seawater environment intensifies the modulus attenuation, but it helps to enhance the damping performance. An increase in confining pressure strengthens the modulus and suppresses damping. A fitting function for the relationship between G <sub>dmax</sub> and rubber content is proposed. This fitting function has good accuracy and can provide a basis for evaluating the G <sub>dmax</sub> of rubber cement soil. This study reveals the dynamic response mechanism and material adaptability of rubber cement soil under harsh erosion conditions, providing a theoretical and experimental basis for its wide application in Marine engineering. © 2025 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved.},
	author_keywords = {damping ratio; dynamic shear modulus; resonance column; rubber cement soil; seawater erosion},
	keywords = {Coastal engineering; Deterioration; Dynamics; Elastic moduli; Erosion; Marine engineering; Osmosis; Pore structure; Rubber; Seawater corrosion; Soil cement; Soil erosion; Soil testing; Soils; Cement soil; Confining pressures; Damping ratio; Dynamic shear modulus; Dynamics characteristic; Fitting functions; Resonance column; Rubber cement soil; Rubber content; Seawater erosion; Damping; Dynamic loads},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Li20141107,
	author = {Li, Shuai and Raoof, Amir and Schotting, Ruud},
	title = {Solute dispersion under electric and pressure driven flows; pore scale processes},
	year = {2014},
	journal = {Journal of Hydrology},
	volume = {517},
	pages = {1107 - 1113},
	doi = {10.1016/j.jhydrol.2014.06.049},
	url = {https://www.scopus.com/pages/publications/84904393994?origin=resultslist},
	abstract = {Solute dispersion is one of the major mixing mechanisms in transport through porous media, originating from velocity variations at different scales, starting from the pore scale. Different driving forces, such as pressure driven flow (PDF) and electro-osmotic flow (EOF), establish different velocity profiles within individual pores, resulting in different spreading of solutes at this scale. While the velocity profile in PDF is parabolic due to the wall friction effects, the velocity in EOF is typically plug flow, due to the wall charge effects. In this study, we applied a pore network modeling formulation to simulate the velocity field driven by pressure and electric potential to calculate and compare the corresponding average solute dispersivity values. The influence of different driving forces on the hydrodynamic dispersion of a tracer solute is investigated. Applying the pore network modeling, we could capture the velocity variations among different pores, which is the main contribution for the dispersion coefficient. The correlation between pore velocities against pore sizes is found to be different for EOF and PDF, causing different solute dispersion coefficients. The results can provide insight into modeling of electrokinetic remediation for contaminant cleanup in low permeable soils. © 2014 Elsevier B.V.},
	author_keywords = {Electro-osmotic flow; Hydrodynamic dispersion; Pore network modeling; Pressure driven flow},
	keywords = {Electroosmotic flow; Hydrodynamic dispersions; Pore scale; Pore-network modeling; Pressure-driven flows; Solute dispersions; dispersion; dispersivity; electrokinesis; mixing; pollutant; solute; tracer; velocity profile},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 23}
}


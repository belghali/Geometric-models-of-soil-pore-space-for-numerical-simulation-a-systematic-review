@CONFERENCE{Mahabadi20171201,
	author = {Mahabadi, Nariman and Jang, Jaewon},
	title = {Fluid displacement patterns in porous media-3D pore-network modeling},
	year = {2017},
	journal = {ICSMGE 2017 - 19th International Conference on Soil Mechanics and Geotechnical Engineering},
	volume = {2017-September},
	pages = {1201 - 1204},
	url = {https://www.scopus.com/pages/publications/85045339262?origin=resultslist},
	abstract = {Multiphase fluid flow in porous media is found in various areas such as oil and gas recovery, hydrology, geological CO2 sequestration, and soil remediation. The preferential flow channel formed by invading fluid is a critical constraint in those processes. In this study, a three-dimensional pore network model is employed to explore the pore scale characteristics affecting the displacement pattern. A wide range of capillary numbers and viscosity ratios is adopted in a time-dependent two-phase flow simulation. The results show that wider statistical pore size distribution and higher pore connectivity results in higher saturation of the invading fluid for all the three major flow regimes including viscous fingering, capillary fingering and stable displacement. The boundary between stable displacement and capillary fingering regime becomes indiscernible for the networks of uniform statistical pore size distribution and low pore coordination number. The boundary of viscous fingering regime moves to higher viscous numbers (higher logM) as the pore size variation decreases or pore connectivity increases. © 2017 19th ICSMGE Secretariat. All rights reserved.},
	author_keywords = {Displacement pattern; Multiphase fluid flow; Pore-network modeling},
	keywords = {Channel flow; Geotechnical engineering; Groundwater flow; Pore size; Porous materials; Size distribution; Soil conservation; Soil mechanics; Soil pollution; Soils; Capillary fingering; Coordination number; Critical constraints; Displacement patterns; Multi-phase fluid flow; Pore size variation; Pore-network modeling; Three-dimensional pores; Two phase flow},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},

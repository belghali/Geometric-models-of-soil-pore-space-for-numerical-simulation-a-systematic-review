@ARTICLE{Lin2026,
	author = {Lin, Dantong and Bradford, Scott Alan and Cao, Yazhou and Tang, Minpeng and Zhang, Baoqing and Hu, Liming},
	title = {Multi-scale pore network approaches for predicting collector efficiency of colloids across a wide density range in soil hydrologic systems},
	year = {2026},
	journal = {Advances in Water Resources},
	volume = {214},

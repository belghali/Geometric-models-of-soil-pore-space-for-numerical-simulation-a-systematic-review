@inproceedings{ WOS:000350281300091,
Author = {Zacher, G. and Paul, T. and Halisch, M. and Westenberger, P.},
Editor = {Khalili, N and Russell, AR and Khoshghalb, A},
Title = {Qualitative and quantitative investigation of soils and porous rocks by
   using very high resolution X-ray micro-CT imaging},
Booktitle = {UNSATURATED SOILS: RESEARCH \& APPLICATIONS, VOLS 1 AND 2},
Year = {2014},
Pages = {699-702},
Note = {6th International Conference on Unsaturated Soils (UNSAT), Sydney,
   AUSTRALIA, JUL 02-04, 2014},
Organization = {Univ New S Wales; Ctr Infrastructure \& Safety},
Abstract = {Today's high-resolution X-ray CT with its powerful tubes and great
   detail detectability lends itself naturally to geological and
   pedological applications. Those include the non-destructive interior
   examination and textural analysis of rock and soil samples and their
   permeability and porosity, the study of oil occurrences in reservoir
   lithologies, and the analysis of morphology and density distribution in
   sediments-to name only a few. Especially spatial distribution of pores,
   mineral phases and fractures are important for the evaluation of
   reservoir properties as well as for root growth. The possibility to
   visualize a whole soil aggregate or plug volume in a non-destructive way
   is undoubtedly the most valuable feature of this type of analysis and is
   a new area for routine application of high resolution X-ray CT.
   In our first example we will show a soil aggregate containing moss
   scanned at very high resolution (1 mu m). The purpose was to show
   highest possible spatial resolution as well as very good contrast
   resolution, which is necessary to distinguish biogenic material in this
   aggregate. Very delicate details can be visualized in the range of 1-2
   mu m.
   The second example is a detailed analysis of a rice root (Oryza sativa
   L.) scanned with a resolution of 1.4 mu m. Hereby the main interest is
   the three-dimensional distribution of iron coatings. The roots filigree
   structure can also be analysed in 3D.
   Next, a typical reservoir rock was scanned with 1 mu m voxel size to
   characterize the pore space and to extract information about the
   distribution of mineral components. The segmented in-situ porosity could
   be easily used for fluid flow modelling purposes, to predict
   permeability and complex flow processes within these structures. The
   data has been analysed with the Avizo software tool XLab Hydro. Besides
   permeability tensor, porosity and pressure drop, the resulting velocity
   field of the fluid particles can be directly visualized whereas the
   colour mapping indicates the velocity's magnitude. The resulting volume
   data can be used to produce surface data for any Computer-Aided Design
   (CAD) application and furthermore for FEM modelling for hydrogeological
   purposes.
   The paper outlines recent developments in hard-and software requirements
   for high resolution CT. It showcases several geological and pedological
   applications which were performed with the phoenix nanotom and recently
   phoenix nanotom m, the first 180 kV nanofocus CT system tailored
   specifically for extremely high-resolution scans of variable sized
   samples (up to 240 mm in diameter and weighing up to 3 kg) with
   voxel-resolutions down to <300 nm.},

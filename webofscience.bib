@inproceedings{ WOS:000775850000064,
Author = {Nassiri, Sina and Mahabadi, Nariman},
Editor = {Lemnitzer, A and Stuedlein, AW},
Title = {Evolution of Porosity-Permeability Relationships in Bio-Mediated
   Processes for Ground Improvement: A Pore-Scale Computational Study},
Booktitle = {GEO-CONGRESS 2022: SITE AND SOIL CHARACTERIZATION, COMPUTATIONAL
   GEOTECHNICS, RISK, AND LESSONS LEARNED},
Series = {Geotechnical Special Publication},

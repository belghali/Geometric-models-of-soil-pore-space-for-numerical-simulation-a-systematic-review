@article{ WOS:001267296600001,
Author = {Zhang, Zhao and Zhu, Kao-fei and He, Yong and Ni, Xue-qian and Wang, Hao
   and Zhang, Ke-neng},
Title = {Investigation on structural evolution and permeability of Cr(VI)
   contaminated sand-bentonite upon loading},
Journal = {CONSTRUCTION AND BUILDING MATERIALS},
Year = {2024},
Volume = {439},
Month = {AUG 16},
Abstract = {Soil-bentonite (SB) vertical cutoff walls are subjected to combined
   external stress and chemical invasion during construction and operation,
   leading to a deterioration in impermeability and retardance performance.
   To address this issue, a series of consolidation-permeability tests and
   microscopic analysis were conducted on Cr(VI) contaminated
   sand-bentonite backfill to study its performance and microstructural
   responses under coupled chemo-mechanical conditions. Experimental
   results demonstrated that the proposed sand-bentonite backfill with 5 \%
   bentonite content showed a low hydraulic conductivity 3.0x10(-8) cm/s,
   sufficiently satisfying the anti-seepage requirement (k<1.0x10(-7) cm/s)
   of the cutoff wall. Microstructural analysis revealed that the
   sand-bentonite backfill presented an initially loose single-porosity
   structure with a peak pore size of 7.19 mu m, regarding contacted sand
   particles as the soil skeleton and bentonite matrix as the pore filler.
   The infiltration of high-concentration Cr(VI) solution improved the
   backfill hydraulic conductivity by promoting the aggregation of
   bentonite layers. Upon loading, sand particles gradually approached and
   squeezed each other, which was accompanied by a transformation of
   bentonite matrix from a lamellar structure into a denser reticular one.
   Furthermore, the hydraulic conductivity of the SB backfills was well
   reproduced using a capillary model considering the pore structure
   evolution. Additionally, the long-term retardance performance of the SB
   vertical cutoff wall was analyzed and evaluated based on a two-dimension
   example by numerical simulation method. Simulation results demonstrated
   that the breakthrough time of a 1.0 m thick cutoff wall could reach
   approximately 9.6 years, indicating a good retardancy capacity of the
   proposed SB cutoff wall.},

@article{ WOS:001546488400002,
Author = {Liu, Juanhong and Cheng, Huan and Liu, Xiaogang and Liang, Jiyong and
   Zuo, Yang and Qiang, Feiyang},
Title = {Characteristics of lunar regolith solidified with low binder content:
   Influencing factors and high-temperature - ultra-low temperature cyclic
   deterioration behavior},
Journal = {CONSTRUCTION AND BUILDING MATERIALS},
Year = {2025},
Volume = {492},
Month = {SEP 19},
Abstract = {The construction of a lunar base represents a pivotal milestone for
   humanity's long-term habitation on the moon and future deep-space
   exploration. In-situ utilization of lunar regolith (LR) presents a
   viable approach. Given the extreme environmental conditions on the lunar
   surface, building materials must possess multiple properties, including
   resistance to both high and ultra-low temperatures. In this study, a
   cured lunar regolith simulant (LRS) material with an exceptionally low
   binder content was developed through high-pressure compaction and
   thermal curing techniques. The mechanical properties and degradation
   mechanisms of the binder-cured LRS material were investigated by
   simulating the lunar surface's high-temperature and
   ultra-low-temperature environments. The results indicate that when
   particle gradation achieves the ``skeleton-filling{''} equilibrium, the
   binder can maximize its interfacial enhancement effect. When the sample
   is mixed with 4 \% binder and compacted under a pressure of 90 MPa, the
   compressive strength can reach 37.8 MPa, and the flexural strength can
   reach 6.6 MPa. An optimal amount of binder can maximize the curing
   efficiency. Additionally, the compaction pressure exhibits a
   proportional relationship with the mechanical properties. The
   high-temperature-ultra-low-temperature cycle affects the compressive
   strengths and flexural strengths of the polymer-cured LRS material. This
   is attributed to the temperature stress generated by differing
   coefficients of thermal expansion and the pore frost heave force
   produced during the low-temperature phase, which leads to the
   coalescence and expansion of small-scale pores, resulting in pore
   coarsening, interfacial de-adhesion, or structural damage, thereby
   diminishing the material's mechanical properties. The curing of LR with
   low binder content provide reference for the development of construction
   materials utilizing in-situ resource utilization on the moon.},

@article{ WOS:000411868400007,
Author = {Mehmani, Yashar and Tchelepi, Hamdi A.},
Title = {Minimum requirements for predictive pore-network modeling of solute
   transport in micromodels},
Journal = {ADVANCES IN WATER RESOURCES},
Year = {2017},
Volume = {108},
Number = {SI},
Pages = {83-98},
Month = {OCT},
Abstract = {Pore-scale models are now an integral part of analyzing fluid dynamics
   in porous materials (e.g., rocks, soils, fuel cells). Pore network
   models (PNM) are particularly attractive due to their computational
   efficiency. However, quantitative predictions with PNM have not always
   been successful. We focus on single-phase transport of a passive tracer
   under advection-dominated regimes and compare PNM with high-fidelity
   direct numerical simulations (DNS) for a range of micromodel
   heterogeneities. We identify the minimum requirements for predictive PNM
   of transport. They are: (a) flow-based network extraction, i.e.,
   discretizing the pore space based on the underlying velocity field, (b)
   a Lagrangian (particle tracking) simulation framework, and (c) accurate
   transfer of particles from one pore throat to the next. We develop novel
   network extraction and particle tracking PNM methods that meet these
   requirements. Moreover, we show that certain established PNM practices
   in the literature can result in first-order errors in modeling
   advection-dominated transport. They include: all Eulerian PNMs, networks
   extracted based on geometric metrics only, and flux-based nodal transfer
   probabilities. Preliminary results for a 3D sphere pack are also
   presented. The simulation inputs for this work are made public to serve
   as a benchmark for the research community. (C) 2017 Elsevier Ltd. All
   rights reserved.},
Publisher = {ELSEVIER SCI LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Mehmani, Y (Corresponding Author), Stanford Univ, Dept Energy Resources Engn, Green Earth Sci 050, 367 Panama St, Stanford, CA 94305 USA.
   Mehmani, Yashar; Tchelepi, Hamdi A., Stanford Univ, Dept Energy Resources Engn, Green Earth Sci 050, 367 Panama St, Stanford, CA 94305 USA.},
DOI = {10.1016/j.advwatres.2017.07.014},
ISSN = {0309-1708},

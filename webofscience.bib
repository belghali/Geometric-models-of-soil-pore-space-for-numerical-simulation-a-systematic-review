@inproceedings{ WOS:001586194700023,
Author = {Daneshian, Behrooz and Hosseini, Reihaneh and Abdelaziz, Sherif L.},
Editor = {Beauregard, MS and Budge, AS},
Title = {Predicting the Pore Size Distribution of Saturated Clay at Different
   Temperatures Using Pore Network Analysis},
Booktitle = {GEOTECHNICAL FRONTIERS 2025: EMERGING TOPICS AND GEOTECHNOLOGIES},
Series = {Geotechnical Special Publication},
Year = {2025},
Volume = {365},
Pages = {221-230},
Note = {2025 Geotechnical Frontiers, Louisville, KY, MAR 02-05, 2025},
Abstract = {This study investigates the impact of freezing temperatures on the
   microstructural evolution of saturated clay, utilizing the pore network
   modeling (PNM) approach. This approach is a computational technique
   widely used for simulating single-phase and multi-phase flow within
   porous media. In this study, a PNM is developed to simulate the
   intrusion process occurring in Mercury Intrusion Porosimetry (MIP)
   testing on saturated clay samples, aiming to estimate soil's pore size
   distribution. First, MIP tests are conducted on saturated clay samples
   at 20 degrees C and -15 degrees C, and the resulting pore size
   distributions are recorded. Then, for each temperature examined, the
   PNM's parameters are optimized by matching the mercury saturation versus
   mercury injection pressure curve generated by the PNM to that observed
   from MIP test. Once the PNM was calibrated, the pore size distribution
   was estimated by calculating the derivative of predicted mercury
   saturation with respect to mercury injection pressure. The results of
   this study suggest that the proposed PNM has the potential to be
   utilized as a predictive tool for estimating the pore size distribution
   of saturated clay at various temperatures. The primary advantage of this
   methodology is its ability to predict alterations in the pore structure
   of saturated clay under any given freezing temperature, potentially
   obviating the need for laborious and costly MIP testing.},

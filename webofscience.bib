@article{ WOS:001649022500001,
Author = {He, Jie and Chen, Cong and Liu, Fangcheng and Sun, Bai and Liu, Qing and
   You, Long},
Title = {Dynamic characteristics of rubber-cement soil in seawater corrosive
   environments},
Journal = {ENGINEERING RESEARCH EXPRESS},
Year = {2025},
Volume = {7},
Number = {4},
Month = {DEC 31},
Abstract = {To enhance the dynamic performance and durability of cement-based soil
   in coastal environments, this paper studies the mechanical behavior of
   rubber-mixed cement soil under the coupled action of dynamic loads and
   seawater erosion. Through systematic resonance column tests, the
   influence laws of seawater concentration, rubber content, and confining
   pressure on the dynamic shear modulus and damping ratio of rubber-cement
   soil were mainly discussed. The results show that during the process of
   seawater erosion, the coupling effect of ion diffusion, expansive force,
   and osmotic pressure leads to the damage of the soil skeleton and the
   roughening of the pore structure, causing edge cracking. However, the
   incorporation of rubber significantly alleviates this deterioration
   trend. After 28 days of seawater erosion, with the increase of rubber
   content, the dynamic shear modulus showed a nonlinear change of first
   decreasing and then increasing, while the damping ratio first increased
   and then decreased and tended to stabilize. Specifically, when the
   rubber content is 15\% and 20\%, the maximum dynamic shear modulus
   increases by 12.9\% and 30.7\% respectively, compared with that before
   erosion, demonstrating a significant performance recovery effect. In
   addition, the high-concentration seawater environment intensifies the
   modulus attenuation, but it helps to enhance the damping performance. An
   increase in confining pressure strengthens the modulus and suppresses
   damping. A fitting function for the relationship between Gdmax and
   rubber content is proposed. This fitting function has good accuracy and
   can provide a basis for evaluating the Gdmax of rubber cement soil. This
   study reveals the dynamic response mechanism and material adaptability
   of rubber cement soil under harsh erosion conditions, providing a
   theoretical and experimental basis for its wide application in Marine
   engineering.},
Publisher = {IOP Publishing Ltd},
Address = {No.2 The Distillery, Glassfields, Avon Street, Bristol, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Chen, C (Corresponding Author), Hunan Univ Technol, Sch Civil Engn, Zhuzhou 412007, Peoples R China.
   He, Jie; Chen, Cong; Liu, Fangcheng; Sun, Bai; Liu, Qing; You, Long, Hunan Univ Technol, Sch Civil Engn, Zhuzhou 412007, Peoples R China.
   He, Jie, Hunan Railway Profess Technol Coll, Zhuzhou, Hunan, Peoples R China.},

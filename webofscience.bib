@article{ WOS:001787774300001,
Author = {Lin, Dantong and Bradford, Scott Alan and Cao, Yazhou and Tang, Minpeng
   and Zhang, Baoqing and Hu, Liming},
Title = {Multi-scale pore network approaches for predicting collector efficiency
   of colloids across a wide density range in soil hydrologic systems},
Journal = {ADVANCES IN WATER RESOURCES},
Year = {2026},
Volume = {214},
Month = {AUG},
Abstract = {Colloid transport in porous media plays a key role in mass transfer
   across subsurface environments, yet existing models systematically
   mispredict particles less dense than water (rho < 1 g/cm(3)), including
   emerging contaminants such as microplastics and remediation techniques
   using micro-nanobubbles. Traditional colloid filtration theory
   (CFT)-based correlations, widely applied to dense colloids using
   simplified Happel sphere-in-cell flow fields, yield unphysical results
   for buoyant particles. Moreover, the dependence of collector efficiency
   on colloid density and its potential asymmetry around the fluid density
   have not yet been quantitatively revealed. To address these limitations,
   we develop a predictive multi-scale framework that integrates finite
   element simulations for pore-throat collector efficiency (eta t),
   discrete element methods to extract pore structure parameters, and pore
   network modeling to upscale and predict macroscopic collector efficiency
   (eta(M)). Two neural network models are trained to predict eta(t) and
   eta(M), both achieving high accuracy (R-2 > 0.97). Results show that
   collector efficiency is strongly density-dependent and often asymmetric.
   At pore-throat scale, 50.9\% of cases exhibit significant density
   dependence and 55.5\% display pronounced asymmetry, while at macroscale,
   the proportion of cases with significant density effects remains
   similar, and asymmetry is still notable (35.9\%). These findings
   highlight the interplay among advection, dispersion, and nonlinear
   directional effective gravity, modulated by colloid size, flow velocity,
   and pore geometry. A case study on micro-nanobubbles further
   demonstrates the substantial impact of buoyancy for larger bubbles under
   low-flow conditions. This framework resolves fundamental predictive gaps
   and enables accurate modeling of colloid transport across soil, aquatic,
   and engineered systems.},

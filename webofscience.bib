@inproceedings{ WOS:001516514500129,
Author = {Alam, M. S. and Mufti, S. and Das, A.},
Editor = {Chareyre, B and Dano, C and Viggiani, G},
Title = {NUMERICAL INVESTIGATION OF PARTICLE CRUSHING EFFECT ON PORE STRUCTURE
   EVOLUTION AND UNSATURATED SOIL CHARACTERISTICS},
Booktitle = {TC 105 INTERNATIONAL SYMPOSIUM},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2025},
Volume = {1480},
Note = {5th International Symposium on Geomechanics from Micro to
   Macro-IS-Grenoble, Grenoble, FRANCE, SEP 23-27, 2024},
Organization = {Region Auvergne-Rhone-Alpes; CNRS},
Abstract = {The behavior of soil under various conditions, including its water
   retention capacity and hydraulic conductivity, is crucial for
   understanding numerous geotechnical and environmental processes. One
   significant factor influencing these properties is grain crushing, which
   refers to the process by which soil particles undergo deformation or
   breakage under applied stress. In the present study, the hydro
   -mechanical behavior of uncrushed and crushed Qrock sand is analyzed
   using pore network modeling. The soil water retention curve (SWRC) is
   given as an input, which is optimized using a genetic algorithm to get a
   pore network. The drainage process is then simulated in the obtained
   synthetic pore network to get the drying branch of SWRC and hydraulic
   conductivity function (HCF). The obtained network reveals the impact of
   crushing on pore characteristics and HCF.},

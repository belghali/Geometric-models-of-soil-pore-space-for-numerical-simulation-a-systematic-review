@article{ WOS:001785664000001,
Author = {Cao, Zhilin and Xie, Qiang and Song, Zhanping and Luo, HaoYang and Sun,
   Weichen and Shen, XiaoLe and Zan, Wenbo},
Title = {Investigation into erosion of gap-graded soil-rock mixtures considering
   fine particle contents and seepage directions},
Journal = {ACTA GEOTECHNICA},
Year = {2026},
Month = {2026 JUN 6},
Abstract = {In geotechnical systems, the seepage direction often deviates from the
   gravity direction, potentially altering erosion mechanisms in soil-rock
   mixtures (SRMs). This study systematically investigates the internal
   erosion behavior of gap-graded SRMs under varying fine contents (FC =
   20\%, 40\%, 60\%, and 80\%) and flow-gravity angles (0 degrees, 30
   degrees, 60 degrees, and 90 degrees) through an integrated approach
   combining laboratory experiments and numerical simulations. A novel
   steerable seepage test device was developed to conduct a series of
   laboratory erosion tests, enabling precise control of the seepage
   direction and quantitative measurement of fine particle loss.
   Complementing the experiments, a coupled pore network model (PNM),
   computational fluid dynamics (CFD), and discrete element method (DEM)
   framework was employed to simulate the multiscale erosion process,
   capturing the evolution of particle migration, contact structure, and
   porosity under seepage and triaxial loading conditions. Both macro- and
   microscale responses were analyzed. Results show that fine content (FC)
   fundamentally governs the erosion susceptibility and structural
   response. Larger FCs lead to higher fine particle loss rates due to the
   transition from a stable coarse-dominated skeleton to a weak
   fine-dominated structure. Concurrently, larger flow-gravity angles
   reduce the rate and extent of fine particle loss due to increased
   resistance from gravitational components, especially at higher FCs. The
   dominant force chain shifts from coarse particle-supported networks at
   low FCs to fine-dominated structures at high FCs, with greater
   vulnerability to collapse. Furthermore, inclined seepage induces complex
   erosion patterns, affecting both the internal structure and global
   mechanical behavior.},

Title = {Porous media modeling from tubular shapes and computed tomography images},
Booktitle = {PROCEEDINGS OF THE IEEE INTERNATIONAL CONFERENCE ON COMPUTING NETWORKING
   AND INFORMATICS (ICCNI 2017)},
Year = {2017},
Note = {International Conference on Computing Networking and Informatics
   (ICCNI), Covenant Univ, Ctr Entrepreneurial Dev Studies, Ota, NIGER, OCT
   29-31, 2017},
Organization = {IEEE; Covenant Univ; Covenant Univ, Dept Elect \& Informat Engn;
   Covenant Univ, Dept Comp \& Informat Sci},
Abstract = {this paper develops a framework for complex shape modeling with
   geometrical primitives. A skeleton based approximation method called
   Adaptive Circular Generalized cylinders (ACGC) is proposed for the
   description of natural porous media cavities using nondestructive
   images. The cavities skeleton are first approximated by spline curve
   running through a set of balls centers. Then, the ACGCs surfaces are
   constructed as rotational sweep of profile curves around the skeleton.
   The profile curves are sinusoidal curve envelopes solution of a partial
   differential equations system. The sinusoidal curve is an interpolation
   of the balls center and a set of contour points. An algorithm for the
   ACGC surface computation is proposed and computed tomography (CT) images
   of real soil sample was used to illustrate the proposed framework. The
   results lead to the conclusion that, compared to previous methods, the
   proposed approximation procedure gives better description of porous
   media cavities with more realistic shapes. Thus in future work, the ACGC
   representation will be used to investigate biological process inside
   natural porous media such as soil burrow systems and tubular organs of
   human body.},

@article{ WOS:001712435100001,
Author = {Xu, Chuanyong and Kong, Lingwei and Li, Tianguo and Zhou, Zhenhua and
   Lin, Huanwen},
Title = {Evolution characteristics of fissure structure and permeability of
   undisturbed highly expansive soils in cold regions under the full range
   of seasonal variation},
Journal = {COLD REGIONS SCIENCE AND TECHNOLOGY},
Year = {2026},
Volume = {247},
Month = {JUN},
Abstract = {Expansive soil slopes are highly susceptible to erosion and infiltration
   during extreme rainfall events, leading to rapid soil saturation and
   increasing the risk of shallow landslides. Therefore, further revealing
   the effects of seasonal climatic variations on the degradation behavior
   of microscopic fissure structure and macroscopic hydraulic properties is
   of significant meaning. In this study, the disintegration and
   permeability tests were conducted on the undisturbed highly expansive
   soils subjected to multiple wetting-drying-freeze-thaw (WDFT) cycles.
   Digital photography and scanning electron microscope (SEM) were then
   employed to analyze surface cracks and internal microscopic morphology
   of the soil samples. X-ray computed tomography (CT) was performed to
   enable visual qualitative and statistical quantitative analyses of the
   two-dimensional grayscale images, three-dimensional morphology,
   evolution of initial fissures, and spatial distribution of flow fields
   in undisturbed expansive soils. The results suggest that seasonal
   variation promotes the propagation of fissure structure in expansive
   soil, accelerating the process of water infiltration. The degree of
   disintegration in highly expansive soils is determined by moisture
   content, the distribution of initial fissures, and their propagation
   following WDFT cycles. The stable fissure network is essentially formed
   after five WDFT cycles, but the orientation of initial fissures in
   samples subjected to one cycle should still receive attention. Based on
   the pore network model and seepage behavior simulation, the small throat
   dimensions within tabular fissure fabric and the low coordination number
   of pores account for the low permeability coefficient of highly
   expansive soils. The grey correlation analysis indicates that the
   quantity and volume parameters directly related to the interconnected
   fissures are the primary factors contributing to soil permeability.},

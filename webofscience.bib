@article{ WOS:001623312800001,
Author = {Liao, Mingke and Wang, Gang and Zhang, Zhichao},
Title = {A thermodynamic constitutive model for internally unstable soil after
   fine particle loss},
Journal = {COMPUTERS AND GEOTECHNICS},
Year = {2026},
Volume = {190},
Month = {FEB},
Abstract = {Internally unstable soils are those where the coarse-grained skeleton
   cannot effectively retain fines, rendering them prone to internal
   erosion under seepage. This process entails particle migration, changes
   in pore structure, and degradation of mechanical properties, among which
   the degradation of mechanical properties is particularly critical to the
   stability and durability of foundations, slopes, and other geotechnical
   structures involving internally unstable soils. A thermodynamic
   constitutive model for internally unstable soils is developed to
   characterize the effects of fine particle loss on the mechanical
   properties. The state-dependent couplings between elasticity and
   plasticity are accounted for in internally unstable soils within the
   thermodynamic framework, considering the stiffness degradation of soils
   induced by fine particle loss. The state boundary of the soil before and
   after fine particle loss is naturally derived from the perspective of
   elastic stability. By introducing the concept of granular fluctuation
   into non-equilibrium thermodynamics principles, both the plastic
   constitutive equation and the granular temperature evolution equation
   are derived, thus relating the macroscopic plastic deformation of the
   soil to mesoscopic energy dissipation. The model's performance is
   validated through erosion tests under different hydraulic loadings, as
   well as tests involving salt substitution for specific fine particles.
   These validation results demonstrate that the model can effectively
   simulate the strength degradation, dilatancy behavior, and critical
   state of internally unstable soils induced by fine particle loss under
   various stress paths.},
